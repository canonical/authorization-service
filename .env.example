# Authorization Service Configuration
# Copy this file to .env and customize as needed

# Server Configuration
SERVER_GRPC_PORT=9091
SERVER_HTTP_PORT=8070
SERVER_HOST=0.0.0.0
SERVER_SHUTDOWN_TIMEOUT=15s
SERVER_DEVELOPMENT=false

# External Authorization Service Configuration
EXT_AUTHZ_SERVICE_JWK_SET_URL=http://localhost:8080/.well-known/jwks.json

# OpenFGA Configuration
OPEN_FGA_ADDRESS=http://localhost:8081
OPEN_FGA_STORE_ID=
OPEN_FGA_AUTHORIZATION_MODEL_ID=
OPEN_FGA_API_KEY=
OPEN_FGA_TIMEOUT=10s

# Valkey Configuration (Caching)
VALKEY_ENABLED=false
VALKEY_ADDRESS=localhost:6379
VALKEY_USERNAME=
VALKEY_PASSWORD=
VALKEY_DB=0
VALKEY_POOL_SIZE=10
VALKEY_TIMEOUT=5s
VALKEY_USE_TLS=false

# Postgres Configuration (Durability & Work Queue)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=authz
POSTGRES_PASSWORD=authz-password
POSTGRES_DB_NAME=authorization-service
POSTGRES_SSL_MODE=disable
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=5
POSTGRES_CONN_MAX_LIFETIME=30m
POSTGRES_CONN_MAX_IDLE_TIME=5m
POSTGRES_CONNECT_TIMEOUT=10s

# STS Configuration (Secure Token Service)
STS_ADDRESS=localhost:9090
STS_USE_TLS=false
STS_TIMEOUT=10s
STS_EAGER_CONNECTION_CHECK=false

# Kafka Configuration (Ingestion Listener)
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_FEDERATED_SERVICES=
KAFKA_CONSUMER_GROUP=authz-listener
KAFKA_TOPIC_PARTITIONS=1
KAFKA_TOPIC_REPLICATION_FACTOR=1

# Worker Configuration (Async Permission Update Worker)
WORKER_ENABLED=false
WORKER_BATCH_SIZE=100
WORKER_POLL_INTERVAL=1s
WORKER_MAX_ATTEMPTS=5
WORKER_RETRY_BACKOFF=5m
WORKER_STALE_TIMEOUT=15m
WORKER_REAPER_INTERVAL=1m

# Logging Configuration
LOGGING_LEVEL=info
LOGGING_FORMAT=json

# Telemetry Configuration (OpenTelemetry)
TELEMETRY_ENABLED=false
TELEMETRY_OTLP_ENDPOINT=
TELEMETRY_SERVICE_NAME=authorization-service
TELEMETRY_SERVICE_VERSION=v1.0.0
