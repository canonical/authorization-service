# Authorization Service Configuration
# Copy this file to .env and customize as needed

# Server Configuration
GRPC_PORT=9090
HTTP_PORT=8888
SERVER_HOST=0.0.0.0
SERVER_SHUTDOWN_TIMEOUT=30s

# OpenFGA Configuration
OPENFGA_ENABLED=true
OPENFGA_ADDRESS=localhost:8081
OPENFGA_STORE_ID=
OPENFGA_AUTH_KEY=
OPENFGA_USE_TLS=false
OPENFGA_TIMEOUT=10s

# Valkey Configuration
VALKEY_ADDRESS=localhost:6379
VALKEY_PASSWORD=
VALKEY_DB=0
VALKEY_POOL_SIZE=10
VALKEY_TIMEOUT=5s
VALKEY_USE_TLS=false

# STS Configuration
STS_ADDRESS=localhost:9091
STS_USE_TLS=false
STS_TIMEOUT=10s

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Telemetry Configuration
TELEMETRY_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=authorization-service
OTEL_SERVICE_VERSION=v1.0.0

# Worker Configuration (async permission-update worker: claims rows from the
# work table and applies tuple changes to OpenFGA)
WORKER_ENABLED=false
WORKER_BATCH_SIZE=100
WORKER_POLL_INTERVAL=1s
WORKER_MAX_ATTEMPTS=5
WORKER_RETRY_BACKOFF=5m
WORKER_STALE_TIMEOUT=15m
WORKER_REAPER_INTERVAL=1m
