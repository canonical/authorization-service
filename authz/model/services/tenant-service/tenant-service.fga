module tenant-service

type account
  relations
    define can_view: [user, user:*, role#assignee]

type tenant
  relations
    define owner: [user]
    define member: [user] or owner
    define can_view: [group#member, role#assignee] or member
    define can_edit: [group#member, role#assignee] or owner
    define can_delete: [group#member, role#assignee] or owner


