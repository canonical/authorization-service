  "cards": [
    {
      "dot": "rose",
      "title": "Removed Dead & Duplicate Code",
      "items": [
        "Deleted unused internal/integration/openfga/client.go stub",
        "Removed unused Offset, PageSize, defaultPage, defaultPageSize in postgres/client.go",
        "Removed unused envconfig/default struct tags and inline STS gRPC dialer in config/specs.go",
        "Removed custom splitCookies parser, duplicate countSegments helpers, and CLI signal/metrics boilerplate"
      ]
    },
    {
      "dot": "emerald",
      "title": "Repurposed Lifecycle & Configuration",
      "items": [
        "Extracted cmd/runner.go (runManagedProcess & ComponentRunner) for worker, listen, and reaper",
        "Scoped config.InitializeIntegrations(components...) so seed, migrate, check, and write-model init only needed clients",
        "Moved STS gRPC connection & readiness wait into internal/integration/sts/client.go",
        "Added PostgresConfig.DSN() fallback to migrate and --token + tracerShutdown to authz check"
      ]
    },
    {
      "dot": "cyan",
      "title": "Standardized Domain, Repo & Telemetry",
      "items": [
        "Centralized rules.CountSegments and cached compiled regexes via sync.Map in RuleMatcher",
        "Narrowed RuleSeeder dependency to repository.RuleSeedRepository with UUIDv7 and ObserveQuery metrics",
        "Injected request_id in logging.TraceHandler and standardized context-aware slog.*Context calls across packages"
      ]
    }
  ]
