  "cards": [
    {
      "dot": "cyan",
      "title": "Sync authz check (serve)",
      "items": [
        "Envoy ext_authz Check \u2192 session cookie \u2192 STS ExchangeSession \u2192 JWT verify (remote JWKS)",
        "Rules mapper matches method+path against Postgres rules and resolves OpenFGA tuples",
        "OpenFGA BatchCheck returns allow/deny; allowed requests get the JWT forwarded as bearer"
      ]
    },
    {
      "dot": "emerald",
      "title": "Async ingestion pipeline",
      "items": [
        "listen consumes <slug>.permissions topics and inserts permission_update_work rows",
        "worker claims batches (retry \u2264 max-attempts) and applies tuple writes to OpenFGA idempotently",
        "In-process reaper (or one-off `reaper` cmd) reclaims stale 'processing' rows"
      ]
    },
    {
      "dot": "violet",
      "title": "Binary & processes",
      "items": [
        "Single Go binary: main.go \u2192 cobra root `authz-service` (cmd/root.go:21)",
        "Process chosen by subcommand (cmd/root.go:84-91): serve, listen, worker",
        "k8s: Deployment runs `app serve`; migrate runs as a CronJob",
        "One-off commands: migrate, seed, reaper, ensure-topics, authz model ops"
      ]
    },
    {
      "dot": "rose",
      "title": "Not yet wired",
      "items": [
        "Permissions API: service constructed and injected into the gRPC server, but registration is absent (gateway TODO at server/rest/gateway.go:82)",
        "REST gateway currently serves only /healthz"
      ]
    }
  ]
