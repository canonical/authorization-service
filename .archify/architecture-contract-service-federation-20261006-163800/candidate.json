  "cards": [
    {
      "dot": "cyan",
      "title": "Multi-Domain Gateway Exposure & Response Stripping",
      "items": [
        "Subset endpoints (/api/v0/contracts, /api/v0/contracts/{id}) exposed directly on Main Istio Gateway (portal.example.com)",
        "Envoy Response Transformation Filter (Wasm/Lua) strips internal payload fields on egress before returning to portal users",
        "Contracts Istio Gateway on the side exposes full domain endpoints on a distinct domain (contracts.example.com)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Identity & AuthZ Tier (Exposed by Istio)",
      "items": [
        "Main Istio Gateway waypoint triggers Envoy ext_authz gRPC Check on Authorization Service",
        "Session Service / STS and Authorization Service are both deployed within and exposed by the Istio mesh",
        "Authorization Service validates session_id cookies with STS and evaluates fine-grained relationship tuples in OpenFGA",
        "Injects Authorization: Bearer <JWT> upstream to Contract Service with user identity and tenant context"
      ]
    },
    {
      "dot": "amber",
      "title": "Application X & External Access",
      "items": [
        "Application X (portal app) is outside the Istio boundary and calls Contract Service via the dedicated Contracts Gateway",
        "External and partner microservices call Contract Service directly via contracts.example.com using mTLS or API tokens",
        "Preserves unstripped payload fields and administrative access for authorized service callers without portal proxy overhead"
      ]
    },
    {
      "dot": "violet",
      "title": "Kafka Event Mesh & Asynchronous Sync",
      "items": [
        "Contract Service publishes contract.permissions and domain lifecycle events (contract.events) to Kafka",
        "Authz Listener consumes permissions topics and persists batch rows into PostgreSQL work table",
        "Authz Worker claims work batches and idempotently synchronizes relation tuples into OpenFGA",
        "Downstream federated services (billing, notifications, audit) consume domain events and publish updates"
      ]
    }
  ]
