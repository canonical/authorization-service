  "cards": [
    {
      "dot": "cyan",
      "title": "Dual-Auth Ingress & Istio PEP",
      "items": [
        "Unified Istio CUSTOM AuthorizationPolicy routes all traffic through ext_authz (:9091)",
        "Human users supply session cookies; machine clients supply Authorization: Bearer <token>",
        "Credentials inspected at ingress: requests missing both are rejected immediately (401)",
        "Mutated header: upon authorization, Istio injects Authorization: Bearer <sts_jwt> upstream"
      ]
    },
    {
      "dot": "emerald",
      "title": "Hydra Validation & STS Translation",
      "items": [
        "Machine tokens validated cryptographically against Ory Hydra JWKS endpoint",
        "Issuer validation ensures token originates strictly from configured Hydra instance",
        "Machine token exchanged via sts.ExchangeToken; session cookie exchanged via sts.ExchangeSession",
        "Decouples internal microservices: downstreams only trust and verify internal STS ES256 JWTs"
      ]
    },
    {
      "dot": "rose",
      "title": "Strict Zero-Bypass Authorization",
      "items": [
        "Normalized subject: user email for humans, client_id for machine accounts",
        "ResourceMapper maps HTTP method + path to OpenFGA tuple checks",
        "OpenFGA BatchCheck strictly evaluates permissions: zero bypass for service accounts",
        "Machine accounts require explicit relationship tuples configured via future authorization APIs"
      ]
    },
    {
      "dot": "violet",
      "title": "Observability & Operational Metrics",
      "items": [
        "Check outcome metrics record latency, result (allow/deny/error), and reason",
        "Auth method tagged to track user session vs client_credentials volume",
        "OpenTelemetry spans trace STS exchange and OpenFGA BatchCheck latencies",
        "Structured Zap logs capture request_id, subject, and decision context"
      ]
    }
  ]
}