model
  schema 1.2

type user

type group
  relations
    define member: [user with tenant_match]
    define owner: [user with tenant_match]

type role
  relations
    define assignee: [user with tenant_match]
    define owner: [user with tenant_match]

type generic-asset
  relations
    define viewer: [user, role#assignee] or editor
    define editor: [user, role#assignee]

condition tenant_match(tenant_enabled: bool, tenant: string, user_tenant: string) {
  !tenant_enabled || tenant == "" || tenant == user_tenant
}
